[Unit]
Description=BizBuddy production web gateway
After=network.target bizbuddy-api.service

[Service]
Type=simple
User=vangaard
Group=vangaard
WorkingDirectory=/var/lib/bizbuddy
ExecStart=/usr/bin/node /var/lib/bizbuddy/current/ops/gateway.mjs
Restart=always
RestartSec=1
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
