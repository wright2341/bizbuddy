# All optional: the app runs with a local SQLite database and key-free replies.
PUBLIC_API_URL=https://bizbuddy.naijatown.app
# Generate once; keep it stable, private and backed up.
CHATBOT_ENCRYPTION_KEY=
# Optional existing OpenAI integration; leaving this blank uses grounded replies.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional MySQL override; default is backend/bizbuddy.db.
# DATABASE_URL=mysql+pymysql://user:password@127.0.0.1:3306/bizbuddy
# Optional official Meta integrations:
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v24.0
# Optional embedded OpenCode SDK (separate, pinned runtime; no desktop application).
# Free access may be restricted to OpenCode clients. Failures use grounded replies.
BIZBUDDY_AI_PROVIDER=grounded
OPENCODE_RUNTIME_DIR=/var/lib/bizbuddy/opencode-2.4.2
OPENCODE_MODEL=deepseek-v4.1-flash-free
# Required on this VPS: persistent path writable by the API service.
OPENCODE_STATE_DIR=/home/vangaard/bizbuddy/backend/.opencode-workspace
# Optional self-hosted ChatGPT plan connection: no API key or API billing.
# Complete ops/chatgpt-login.py before expecting model-generated replies.
# BIZBUDDY_AI_PROVIDER=chatgpt
CHATGPT_MODEL=gpt-6-luna
CHATGPT_CREDENTIALS_FILE=/home/vangaard/bizbuddy/backend/.chatgpt/credentials.json
# Prototype: all test accounts default to configured managed AI, capped at 100/month.
BIZBUDDY_PROTOTYPE_MODE=true
# Outside prototype mode, managed access can be restricted to specific owners.
# Keep private ChatGPT access limited to the installation owner's workspace IDs.
BIZBUDDY_CHATGPT_OWNER_IDS=1
BIZBUDDY_CHATGPT_PARTNER_APPROVED=false
BIZBUDDY_MANAGED_AI_ENABLED=false
BIZBUDDY_MANAGED_AI_LIMIT=100
